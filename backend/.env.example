# Flask 环境配置
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 安全密钥 (生产环境请使用随机生成的密钥)
SECRET_KEY=local-dev-secret-key
JWT_SECRET_KEY=local-dev-jwt-secret-key

# MongoDB 配置
MONGODB_URI=mongodb://127.0.0.1:27017/latex_trainer
MONGODB_DB=latex_trainer

# CORS 配置
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 管理后台配置
ADMIN_PASSWORD=admin123

# GitHub OAuth 配置
# 在 https://github.com/settings/developers 新建 OAuth App
# Authorization callback URL 填：http://localhost:5173/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth 回调URL
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Token 加密密钥 (使用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成)
TOKEN_ENCRYPTION_KEY=

# 开发环境数据库重置密钥（可选的额外安全保护）
# 警告：此功能仅限开发环境使用，生产环境会自动禁用
# 留空则访问 /api/reset-db 不需要 dev_key 参数
DEV_RESET_SECRET=

# 数据库初始化密钥（用于保护 /api/init-db 接口）
INIT_DB_SECRET=local-init-secret